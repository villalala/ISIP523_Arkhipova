<Page x:Class="PR15.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR15.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="white" 
      Title="MainPage" Loaded="Page_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60*"/>
            <ColumnDefinition Width="40*"/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="ChoiceLstBox" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Margin="10" Source="{Binding image}" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="10" Text="{Binding name}" Grid.Row="0"/>
                            <TextBlock Margin="10" Text="{Binding price}" Grid.Row="0" />
                            </StackPanel>
                            <TextBlock Margin="10" Text="{Binding}" Grid.Row="1"/>
                        </Grid>
                       
                        <Button x:Name="DelBtn" Content="Удалить" Height="25" Margin="10"/>
                        
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Button x:Name="SavedBtn" Content="Сохраненые сборки" Margin="10"/>
                <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
                    <TextBlock Text="Название сборки"/>
                    <TextBox x:Name="NameTextBox" MinWidth="200" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
                    <TextBlock Text="Автор сборки"/>
                    <TextBox x:Name="AuthorTextBox" MinWidth="200" />
                </StackPanel>

                <Button x:Name="SaveBtn" Content="Сохранить" Margin="10" HorizontalAlignment="Center"/>
            </StackPanel>

            <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="ItemLstBox" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}" >
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        
                        <Button x:Name="ItemBtn"  Margin="10" Click="ItemBtn_Click">
                            <TextBlock Text="{Binding name}"/>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Grid>
    </Grid>
</Page>
