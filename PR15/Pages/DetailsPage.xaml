<Page x:Class="PR15.Pages.DetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR15.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="White"
      Title="DetailsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Center">
            <TextBox x:Name="Search" Text="Поиск" Margin="10" Width="200" HorizontalAlignment="Left"/>
            
            <StackPanel Orientation="Vertical" Margin="10" HorizontalAlignment="Right">
                <TextBlock Text="Сортировка:" HorizontalAlignment="Right" />
                <RadioButton x:Name="SortByName" Content="По названию"/>
                <RadioButton x:Name="SortByRating" Content="По рейтингу"/>
            </StackPanel>
        </StackPanel>

        <ListBox x:Name="ItemLstBox" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Row="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <WrapPanel>
                        <Image Margin="10" Source="{Binding image}" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="10" Text="{Binding name}" Grid.Row="0"/>
                                <TextBlock Margin="10" Text="{Binding price}" Grid.Row="0" />
                            </StackPanel>
                            <TextBlock Margin="10" Text="{Binding}" Grid.Row="1"/>
                        </Grid>

                        <Button x:Name="GetBtn" Content="Добавить" Height="25" Margin="10"/>

                    </WrapPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
