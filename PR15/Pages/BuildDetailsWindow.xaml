<Window x:Class="PR15.Pages.BuildDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR15.Pages"
        mc:Ignorable="d"
        Title="BuildDetailsWindow" Height="450" Width="800">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            

            <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding assembl.name}" FontSize="28" />
            <TextBlock Text="{Binding assembl.author}" FontSize="16"  Margin="10" />
            </StackPanel>

            
            <ListBox ItemsSource="{Binding partassemblies}" x:Name="SaveLstBox" Margin="20" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Row="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="15" Orientation="Horizontal">
                            <Image Margin="10" Height="100" Width="100" Source="{Binding basepart.image}"/>
                            <StackPanel>
                                <TextBlock Text="{Binding basepart.name}" Margin="10"/>
                                <TextBlock Text="{Binding basepart.manufacturerid}"      Margin="10"/>
                                <TextBlock Text="{Binding parttypeid.name}" Margin="10"/>
                                <TextBlock Text="{Binding basepart.price}"  Margin="10"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" Margin="15" Grid.Row="2">
                <TextBlock Text="Общая стоимость:" FontSize="18"/>
                <TextBlock Text="{Binding price, StringFormat=' {0} ₽'}" 
                           FontSize="24" FontWeight="Bold" Margin="10"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>
