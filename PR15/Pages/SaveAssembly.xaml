<Page x:Class="PR15.Pages.SaveAssembly"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR15.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SaveAssembly"
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0">
            <TextBlock Text="Сохраненные сборки" Margin="10" FontSize="24" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
        <Grid>
            <ListBox x:Name="SaveLstBox" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel >
                                <TextBlock Text="{Binding name}" Margin="10" FontSize="18"/>
                                <TextBlock Text="{Binding author}" FontSize="14"/>
                                <Button x:Name="PartBtn" Content="Детали" Margin="10" Click="PartBtn_Click_1"/>
                                </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        </StackPanel>
    </Grid>
</Page>
