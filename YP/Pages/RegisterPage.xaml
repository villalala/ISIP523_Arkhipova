<Page x:Class="YP.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YP.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegisterPage"
      Background="White">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
        <StackPanel>
            <TextBlock Text="Регистрация" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="10"/>

            <TextBox x:Name="RegLoginBox" Padding="8" Margin="5" Text="Логин"/>
            <PasswordBox x:Name="RegPassBox" Padding="8" Margin="5" Password="Пароль"/>
            <TextBox x:Name="RegNameBox" Padding="8" Margin="5" Text="Имя"/>
            <TextBox x:Name="RegEmailBox" Padding="8" Margin="5" Text="Email"/>

            <Button Content="Создать аккаунт" Height="40" Margin="5" Click="RegBtn_Click" Background="#2196F3" Foreground="White"/>
            <Button Content="Назад ко входу" Height="20" Margin="5" Click="BackBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>