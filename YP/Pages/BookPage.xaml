<Page x:Class="YP.Pages.BookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YP.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookPage"
      Background="White">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Source="{Binding cover}" Height="300" Stretch="Uniform" Margin="10"/>

        <StackPanel Grid.Column="1" Grid.Row="0">
            <TextBlock Text="{Binding name}" FontSize="20" FontWeight="Bold" Margin="5"/>
            <TextBlock Text="{Binding Users.name, StringFormat='Автор: {0}'}" FontStyle="Italic" Margin="5"/>
            <TextBlock Text="{Binding BookGenre.Count, StringFormat='Жанров: {0}'}" Margin="5"/>
            <TextBlock Text="{Binding Reviews.Count, StringFormat='Отзывов: {0}'}" Margin="5"/>
            <TextBlock Text="{Binding description}" TextWrapping="Wrap" Margin="5"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="1" Margin="10">
            <TextBlock Text="Мой статус:" FontWeight="Bold" Margin="5" FontSize="14" />
            <StackPanel Orientation="Horizontal" Margin="5">
                <RadioButton x:Name="rbPlan" Content="В планах" GroupName="ListStatus" Margin="3"/>
                <RadioButton x:Name="rbRead" Content="Читаю" GroupName="ListStatus" Margin="3" IsChecked="True"/>
                <RadioButton x:Name="rbDone" Content="Прочитано" GroupName="ListStatus" Margin="3"/>
                <RadioButton x:Name="rbDrop" Content="Заброшено" GroupName="ListStatus" Margin="3"/>
            </StackPanel>

            <StackPanel >
                <Button Content="Сохранить статус" Width="140" Click="SaveStatusBtn_Click" HorizontalAlignment="Left" Margin="5"/>
                <Button Content="Читать текст" Width="140" Margin="5" HorizontalAlignment="Left" Click="ReadBtn_Click"/>
            </StackPanel>
        </StackPanel>

        <ListBox x:Name="reviewsList" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Margin="5">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#ccc" BorderThickness="1" Padding="5" Margin="5">
                        <StackPanel>
                            <TextBlock Text="{Binding Users.name}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding text}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding rating, StringFormat='Оценка: {0}/5'}" Foreground="#f39c12"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3" Orientation="Horizontal" Margin="3">
            <TextBox x:Name="inputTextTB" Width="300" Margin="3" Text="Текст отзыва или жалобы..."/>
            <ComboBox x:Name="ratingCB" Width="60" Margin="3" SelectedIndex="4">
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="3"/>
                <ComboBoxItem Content="4"/>
                <ComboBoxItem Content="5"/>
            </ComboBox>
            <Button Content="Оставить отзыв" Margin="3" Click="SubmitReviewBtn_Click"/>
            <Button Content="Жалоба" Margin="3" Click="ComplaintBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>