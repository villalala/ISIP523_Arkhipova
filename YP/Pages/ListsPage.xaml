<Page x:Class="YP.Pages.ListsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YP.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ListsPage"
      Background="White">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Мои списки" FontSize="18" FontWeight="Bold" Margin="10"/>

            <RadioButton Content="Читаю" GroupName="MyLists" Click="StatusFilter_Click" IsChecked="True" Margin="5"/>
            <RadioButton Content="Прочитано" GroupName="MyLists" Click="StatusFilter_Click" Margin="5"/>
            <RadioButton Content="В планах" GroupName="MyLists" Click="StatusFilter_Click" Margin="5"/>
            <RadioButton Content="Заброшено" GroupName="MyLists" Click="StatusFilter_Click" Margin="5"/>
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <ListBox x:Name="booksList" SelectionMode="Single" MouseDoubleClick="BooksList_MouseDoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="180" Margin="5" BorderBrush="#ccc" BorderThickness="1" Padding="10">
                            <StackPanel>
                                <Image Source="{Binding cover}" Height="150" Stretch="UniformToFill" Margin="10"/>
                                <TextBlock Text="{Binding name}" FontWeight="Bold" TextWrapping="Wrap" Height="40"/>
                                <TextBlock Text="{Binding Users.name}" FontStyle="Italic" Foreground="#666"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Grid>
</Page>