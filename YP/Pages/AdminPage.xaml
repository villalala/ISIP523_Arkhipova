<Page x:Class="YP.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YP.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage"
      Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Жалобы и модерация" FontSize="18" FontWeight="Bold" Margin="7"/>

        <DataGrid x:Name="complaintsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="ComplaintsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID_Compl}" Width="50"/>
                <DataGridTextColumn Header="Автор жалобы" Binding="{Binding Users.name}" Width="*"/>
                <DataGridTextColumn Header="Книга" Binding="{Binding Book.name}" Width="*"/>
                <DataGridTextColumn Header="Причина" Binding="{Binding text}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10">
            <Button x:Name="btnToggleUser" Content="Заморозить пользователя" Click="ToggleUser_Click" Margin="10" IsEnabled="False"/>
            <Button x:Name="btnToggleBook" Content="Заморозить книгу" Click="ToggleBook_Click" Margin="10" IsEnabled="False"/>
            <Button Content="Обновить список" Margin="10" Height="20" Click="RefreshBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
