<Page x:Class="YP.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YP.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage"
      Background="White">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
        <StackPanel>
            <TextBlock Text="Вход в систему" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="10"/>

            <TextBox x:Name="LoginBox" Padding="8" Margin="10" Text="Логин"/>
            <PasswordBox x:Name="PassBox" Padding="8" Margin="10" Password="Пароль"/>

            <Button Content="Войти" Height="40" Margin="10" Click="LoginBtn_Click" Background="#4CAF50" Foreground="White"/>
            <Button Content="Нет аккаунта? Регистрация." Height="20" Margin="10" Click="GoToRegBtn_Click" />
        </StackPanel>
    </Grid>
</Page>
