<Page x:Class="YP.Pages.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YP.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthorPage"
      Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="5">
            <TextBlock Text="Кабинет автора" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="+ Добавить книгу" Width="150" HorizontalAlignment="Right" Click="AddBookBtn_Click"/>
        </Grid>

        <TabControl Grid.Row="1">

            <TabItem Header="Мои книги">
                <ListBox x:Name="myBooksList" Margin="10" SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#e0e0e0" BorderThickness="1" Padding="10" Margin="3" Background="#fafafa">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding name}" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="{Binding description}" TextWrapping="Wrap" MaxHeight="40" Foreground="#555"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="✎ Редактировать" Width="100" VerticalAlignment="Center" 
                                            Click="EditBookBtn_Click" Margin="5"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <TabItem Header="Замороженные">
                <ListBox x:Name="frozenBooksList" Margin="10" SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#ffcdd2" BorderThickness="1" Padding="10" Margin="3" Background="#ffebee">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding name}" FontWeight="Bold" Foreground="#c62828"/>
                                        <TextBlock Text="Статус: Заморожена" Foreground="#c62828" FontStyle="Italic"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Оспорить" Width="100" VerticalAlignment="Center" Click="AppealBookBtn_Click" Margin="5"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

        </TabControl>
    </Grid>
</Page>
