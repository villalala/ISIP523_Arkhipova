<Page x:Class="YP.Pages.ReaderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YP.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReaderPage"
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="15" BorderBrush="#e0e0e0" BorderThickness="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="← Назад" Width="100" Click="BackBtn_Click" Margin="5"/>
                    <TextBlock x:Name="BookTitle" Text="Название книги" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" x:Name="TextScroll" VerticalScrollBarVisibility="Auto" Padding="40">
            <Border Background="White" Margin="10" CornerRadius="5">
                <RichTextBox x:Name="TextContent" BorderThickness="0" IsReadOnly="True" FontFamily="Georgia" FontSize="16" Background="Transparent">
                    <RichTextBox.Resources>
                        <Style TargetType="Paragraph">
                            <Setter Property="Margin" Value="5"/>
                            <Setter Property="TextAlignment" Value="Justify"/>
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>