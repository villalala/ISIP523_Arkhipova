<Page x:Class="YP.Pages.AddBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YP.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddBookPage"
      Background="White">

    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock x:Name="PageTitle" Text="Добавление книги" FontSize="20" FontWeight="Bold" Margin="3"/>

            <TextBlock Text="Название книги" FontWeight="SemiBold"/>
            <TextBox x:Name="NameTB" Margin="5"/>

            <TextBlock Text="Ссылка на обложку (URL)" FontWeight="SemiBold"/>
            <TextBox x:Name="CoverTB" Margin="5"/>

            <TextBlock Text="Жанр" FontWeight="SemiBold"/>
            <ComboBox x:Name="GenreCB" Margin="5" DisplayMemberPath="name"/>

            <TextBlock Text="Описание" FontWeight="SemiBold"/>
            <TextBox x:Name="DescTB" Height="80" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="5">
            <TextBlock Text="Текст книги" FontWeight="SemiBold"/>
            <TextBox x:Name="TextTB" Height="250" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

            <Button Content="Сохранить" Width="150" Height="40" Margin="10" Click="SaveBtn_Click" Background="#4caf50" Foreground="White" FontWeight="Bold"/>
            <Button Content="Назад" Width="150" Height="30" Click="BackBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>