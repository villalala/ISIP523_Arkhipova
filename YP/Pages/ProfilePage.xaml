<Page x:Class="YP.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YP.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfilePage"
      Background="White">

    <Grid Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Width="300">
            <TextBlock Text="Мой профиль" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="7"/>

            <TextBlock Text="{Binding login, StringFormat='Логин: {0}'}" Margin="5"/>
            <TextBlock Text="{Binding name, StringFormat='Имя: {0}'}" Margin="5"/>
            <TextBlock Text="{Binding email, StringFormat='Email: {0}'}" Margin="5"/>
            <TextBlock Text="{Binding Roles.name, StringFormat='Роль: {0}'}" Margin="5" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Page>