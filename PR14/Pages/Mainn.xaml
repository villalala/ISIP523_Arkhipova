<Page x:Class="PR14.Mainn"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR14"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Mainn"
      Loaded="Page_Loaded"
      Background="#cfb0b0">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Height="65" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="Profile"  Content="Профиль" Background="#AC7580" Foreground="White" Margin="10" Width="69" Height="30" Click="Profile_Click" Visibility="Hidden"/>
            <TextBox x:Name="SearchBox"  Width="300" Height="30" TextChanged="SearchBox_TextChanged"/>
            <Button x:Name="Reg"  Content="Регистрация" Background="#AC7580" Foreground="White" Margin="10" Width="130" Height="30" Click="Reg_Click"/>
            <Button x:Name="SignIn" Content="Войти" Margin="10" Background="#AC7580" Foreground="White" Width="127" Height="30" Click="SignIn_Click"/>
            <Button x:Name="SignOut" Content="Выход" Margin="10" Background="#AC7580" Foreground="White" Width="127" Height="30" Visibility="Collapsed" Click="SignOut_Click"/>


            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Сортировка:" HorizontalAlignment="Center" Foreground="White"/>
                <RadioButton x:Name="SortByName" Content="По названию" Checked="Sort_Checked" Foreground="White"/>
                <RadioButton x:Name="SortByRating" Content="По рейтингу" Checked="Sort_Checked" Foreground="White"/>
            </StackPanel>
        </StackPanel>
        
        <ListBox x:Name="FilmsLB" Background="#cfb0b0" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="FilmsLB_MouseDoubleClick" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Height="317" Width="220" Background="#BC8F8F">
                        <Image Margin="5" Source="{Binding Cover}" Height="200" Width="200"/>
                        <TextBlock Margin="5" Text="{Binding FilmName, StringFormat= Название: {0}}" Foreground="White"/>
                        <TextBlock Margin="5" Text="{Binding ShowStartDate, StringFormat= Дата начала показа:: {0}}" Foreground="White"/>
                        <TextBlock Margin="5" Text="{Binding Rating, StringFormat= Рейтинг: {0}}" Foreground="White"/>
                        <TextBlock Margin="5" Text="{Binding AgeRating.Name, StringFormat= Возрастной рейтинг: {0}}" Foreground="White"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel/>
            </ItemsPanelTemplate>
             </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
