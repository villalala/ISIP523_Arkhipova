<Page x:Class="PR14.Pages.MovieDetail"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR14.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MovieDetail"
      Background="#cfb0b0">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>


            <Button Content="← Назад"  HorizontalAlignment="Right" Grid.Column="1" Background="#AC7580" Foreground="White" VerticalAlignment="Bottom" Margin="10" Height="30" Width="60" Click="Button_Click"/>



        <StackPanel Grid.Column="0" Grid.RowSpan="2" >
            <Image Height="200" Width="150" Source="{Binding Cover}" Margin="10"/>
            <TextBlock Text="{Binding FilmName}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding AgeRating.Name, StringFormat=Возрастной рейтинг: {0}}" FontSize="15" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding FilmGenre.Genre.GanreName, StringFormat=Жанры: {0}}" FontSize="15" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Rating, StringFormat=Рейтинг: {0}}" FontSize="15" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding ShowStartDate, StringFormat=Дата выхода: {0:dd.MM.yyyy}}" FontSize="15" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Description, StringFormat=Описание : }" FontSize="9" HorizontalAlignment="Center" Grid.Row="1"/>

        </StackPanel>
       
        <TextBlock Text="Сеансы:" Grid.Column="1" FontSize="20" FontWeight="Bold" Margin="10,20,10,5" HorizontalAlignment="Left"/>

        <ListBox x:Name="lbSessions" Grid.Column="1" Height="180" Margin="10" 
         SelectionChanged="lbSessions_SelectionChanged"
         Background="#d8b0b0" Foreground="White" BorderBrush="#AC7580">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DateTime, StringFormat=dd.MM.yyyy}" Width="110" Margin="5"/>
                        <TextBlock Text="{Binding Room}" Width="140" Margin="5"/>
                        <TextBlock Text="{Binding Category}" Width="120" Margin="5"/>
                        <TextBlock Text="{Binding Price, StringFormat={}{0} ₽}" Foreground="#FFD700" FontWeight="Bold" Margin="5"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</Page>
