<Page x:Class="PR14.Pages.SignIn"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR14.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SignIn"
      Background="#cfb0b0">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"> 
            <TextBlock Text="Приветствуем!" Width="130" Height="30" HorizontalAlignment="Center" Foreground="White" TextAlignment="Center" FontSize="17" /> 
            <TextBlock Text="Войти в свой аккаунт?" Width="130" Height="30" HorizontalAlignment="Center" Foreground="White" TextAlignment="Center"/>
            <TextBox x:Name="LoginBT" Text="Логин"  Width="200" Height="30" />
            <TextBox x:Name="PasswordBT" Margin="10" Text="Пароль" Width="200" Height="30"/>
            <Button x:Name="SignIn_But"  Content="Войти" Background="#AC7580" Foreground="White" Margin="10" Width="130" Height="30" Click="SignIn_But_Click" />
            <Button x:Name="Exit_But"  Content="На главную" Background="#AC7580" Foreground="White" Margin="10" Width="130" Height="20" Click="Exit_But_Click"/>
            
        </StackPanel>
    </Grid>
</Page>
