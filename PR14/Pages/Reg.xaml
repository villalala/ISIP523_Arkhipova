<Page x:Class="PR14.Pages.Reg"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR14.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Reg"
      Background="#cfb0b0">

    <Grid>
        <StackPanel>
            <StackPanel Margin="80" HorizontalAlignment="Center">
                <TextBlock Text="Добро пожаловать!" Width="170" Height="30" HorizontalAlignment="Center" Foreground="White" TextAlignment="Center" FontSize="17" />
                <TextBlock Text="Желаете зарегестрироваться?" Width="130" Height="30" HorizontalAlignment="Center" Foreground="White" TextAlignment="Center"/>
                <TextBox x:Name="LoginBT" Text="Логин" Margin="5"  Width="200" Height="30" />
                <TextBox x:Name="PasswordBT" Margin="5" Text="Пароль" Width="200" Height="30"/>
                <TextBox x:Name="Password2" Margin="5" Text="Повторите пароль" Width="200" Height="30"/>
                <TextBox x:Name="Name" Text="Имя" Margin="5" Width="200" Height="30" />
                <DatePicker x:Name="DateBr" Margin="5" Text="Дата Рождения" Width="200" Height="30" />
                <Button x:Name="Reg_But"  Content="Регистрация" Background="#AC7580" Foreground="White" Margin="10" Width="130" Height="30" Click="Reg_But_Click" />
                <Button x:Name="Exit_But"  Content="На главную" Background="#AC7580" Foreground="White" Margin="10" Width="130" Height="20" Click="Exit_But_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
