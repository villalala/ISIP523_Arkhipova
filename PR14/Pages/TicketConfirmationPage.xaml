<Page x:Class="PR14.Pages.TicketConfirmationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Подтверждение билета" Background="#cfb0b0">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Подтверждение покупки" 
                   FontSize="22" FontWeight="Bold" Foreground="White"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock FontSize="17" Foreground="White" Margin="0,0,0,6">
                <TextBlock Text="Фильм: " FontWeight="SemiBold" />
                <TextBlock Text="{Binding FilmName, Mode=OneWay}" />
            </TextBlock>
            <TextBlock FontSize="16" Foreground="White">
                <TextBlock Text="Сеанс: " FontWeight="SemiBold" />
                <TextBlock Text="{Binding SessionInfo, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock FontSize="16" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4">
                Места:
            </TextBlock>
            <TextBlock x:Name="tbSeats" 
                       FontSize="15" Foreground="White" 
                       Text="{Binding SelectedSeats, Mode=OneWay}" 
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,30">
            <TextBlock FontSize="16" Foreground="White" Margin="0,0,0,8">
                <TextBlock Text="Цена за место: " FontWeight="SemiBold" />
                <TextBlock Text="{Binding PricePerSeat, Mode=OneWay, StringFormat={}{0:N2} ₽}" />
            </TextBlock>
            <TextBlock FontSize="19" FontWeight="Bold" Foreground="Gold">
                <TextBlock Text="Итого: " />
                <TextBlock Text="{Binding TotalPrice, Mode=OneWay, StringFormat={}{0:N2} ₽}" />
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Назад" Width="140" Height="42" Margin="0,0,50,0"
                    Background="#555555" Foreground="White" Click="Back_Click"/>
            <Button Content="Подтвердить покупку" Width="210" Height="42"
                    Background="#AC7580" Foreground="White" FontSize="15" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Page>