<Page x:Class="PR14.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR14.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfilePage">

    <Grid>

        <StackPanel Margin="20">

            <TextBlock Text="Личный кабинет"
                   FontSize="22"
                   Margin="0,0,0,20"/>

            <TextBlock Text="Информация об аккаунте"
                   FontSize="16"/>

            <TextBlock Text="{Binding Username}" />
            <TextBlock Text="{Binding Login}" />
            <TextBlock Text="{Binding DateOfBirth}" />

            <TextBlock Text="Мои билеты"
                   FontSize="16"
                   FontWeight="Bold"/>
            <ListBox x:Name="TicketsList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Film}"
                               FontWeight="Bold"/>

                            <TextBlock Text="{Binding Date,
                         StringFormat='Дата: {0:dd.MM.yyyy HH:mm}'}"/>

                            <TextBlock Text="{Binding Room,
                         StringFormat='Зал: {0}'}"/>

                            <TextBlock Text="{Binding Seat,
                         StringFormat='Место: {0}'}"/>

                            <TextBlock Text="{Binding Price,
                         StringFormat='Цена: {0:N2} ₽'}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Content="На главную" Click="Home_Click" Margin="0,15,0,0" Width="170"/>
        </StackPanel>
    </Grid>
</Page>
